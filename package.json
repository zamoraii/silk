{
  "name": "silk-compose",
  "version": "0.0.2",
  "type": "module",
  "description": "An opinionated Lexical rich text editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamoraii/silk.git"
  },
  "keywords": [
    "lexical",
    "rich-text",
    "editor",
    "react",
    "wysiwyg"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/silk.js",
  "module": "./dist/silk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/silk.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/silk.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@lexical/code": "^0.41.0",
    "@lexical/code-shiki": "^0.41.0",
    "@lexical/dragon": "^0.41.0",
    "@lexical/history": "^0.41.0",
    "@lexical/link": "^0.41.0",
    "@lexical/list": "^0.41.0",
    "@lexical/markdown": "^0.41.0",
    "@lexical/react": "^0.41.0",
    "@lexical/rich-text": "^0.41.0",
    "@lexical/selection": "^0.41.0",
    "lexical": "^0.41.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
